    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Подробности заявки</h2>

<div>
    <legend>Заявка</legend>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CreditHead)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreditHead)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.bidDate)
        </dt>
